{
  "name": "webgpu-fractal",
  "version": "0.1.1",
  "description": "Fractal Explorer - GPU-accelerated fractal rendering in the browser",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:examples": "tsc && vite build --outDir examples/webgpu --base ./",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"docs/**/*.md\" \"*.md\" \"*.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"docs/**/*.md\" \"*.md\" \"*.json\""
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.71",
    "prettier": "^3.9.4",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vite-plugin-glsl": "^1.6.0"
  },
  "author": "Skippy the Magnificent (the implementation) + Joe Bishop (the crazy ideas)",
  "license": "MIT"
}
